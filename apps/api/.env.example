# Copiar a .env y completar. Nunca subir .env al repositorio.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
TZ=America/Bogota

# Base de datos (Paso 4)
DATABASE_URL=mysql://rae:CAMBIAR@localhost:3306/seguimiento_rae

# Autenticación (generar con: openssl rand -base64 48)
JWT_ACCESS_SECRET=CAMBIAR_POR_UN_SECRETO_DE_AL_MENOS_32_BYTES
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# Administrador semilla
ADMIN_DOCUMENTO=
ADMIN_CLAVE_INICIAL=
ADMIN_NOMBRE=Administrador

# Correo (smtp | log)
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Seguimiento RAE <no-responder@dominio>"
